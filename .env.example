# Copy to .env.local and fill in the web app configuration from Firebase Console.
# These web identifiers are public client configuration, not service-account secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional web app configuration fields.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Local tests only: set true AND set PROJECT_ID to demo-rocky.
# The production build always rejects emulator mode.
VITE_FIREBASE_USE_EMULATORS=false
